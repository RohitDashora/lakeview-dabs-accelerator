{
  "datasets": [
    {
      "catalog": "samples",
      "displayName": "Daily trips",
      "name": "ds_daily",
      "parameters": [
        {
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "0"
                }
              ]
            }
          },
          "displayName": "min_distance",
          "keyword": "min_distance"
        }
      ],
      "queryLines": [
        "SELECT date_trunc('DAY', tpep_pickup_datetime) AS pickup_date, count(*) AS trips, sum(fare_amount) AS total_fare, sum(trip_distance) AS total_distance ",
        "FROM trips WHERE trip_distance >= :min_distance GROUP BY 1"
      ],
      "schema": "nyctaxi"
    },
    {
      "catalog": "samples",
      "displayName": "Trips",
      "name": "ds_trips",
      "parameters": [
        {
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "0"
                }
              ]
            }
          },
          "displayName": "min_distance",
          "keyword": "min_distance"
        }
      ],
      "queryLines": [
        "SELECT tpep_pickup_datetime, tpep_dropoff_datetime, trip_distance, fare_amount, pickup_zip, dropoff_zip, hour(tpep_pickup_datetime) AS pickup_hour, ",
        "round((unix_timestamp(tpep_dropoff_datetime) - unix_timestamp(tpep_pickup_datetime)) / 60.0, 1) AS duration_min, ",
        "CASE WHEN trip_distance > 0 THEN fare_amount / trip_distance END AS fare_per_mile ",
        "FROM trips WHERE trip_distance >= :min_distance"
      ],
      "schema": "nyctaxi"
    }
  ],
