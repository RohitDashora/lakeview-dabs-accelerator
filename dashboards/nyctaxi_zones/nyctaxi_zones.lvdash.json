{
  "datasets": [
    {
      "catalog": "samples",
      "displayName": "ds_zip",
      "name": "ds_zip",
      "queryLines": [
        "SELECT pickup_zip, dropoff_zip, count(*) AS trips, avg(fare_amount) AS avg_fare, avg(trip_distance) AS avg_distance FROM trips WHERE pickup_zip IS NOT NULL AND dropoff_zip IS NOT NULL GROUP BY pickup_zip, dropoff_zip"
      ],
      "schema": "nyctaxi"
    }
  ],
  "pages": [
    {
      "displayName": "Zips",
      "layout": [
        {
          "position": {
            "height": 1,
            "width": 6,
            "x": 0,
            "y": 0
          },
          "widget": {
            "name": "filter-pickup-zip",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_zip",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "`pickup_zip`",
                      "name": "pickup_zip"
                    },
                    {
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)",
                      "name": "pickup_zip_associativity"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "encodings": {
                "fields": [
                  {
                    "displayName": "pickup_zip",
                    "fieldName": "pickup_zip",
                    "queryName": "main_query"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Pickup zip"
              },
              "version": 2,
              "widgetType": "filter-multi-select"
            }
          }
        },
        {
          "position": {
            "height": 3,
            "width": 2,
            "x": 0,
            "y": 1
          },
          "widget": {
            "name": "kpi-distinct-pickup-zips",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_zip",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "COUNT_DISTINCT(`pickup_zip`)",
                      "name": "countdistinct(pickup_zip)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "data": {
                "queryName": "main_query"
              },
              "encodings": {
                "value": {
                  "displayName": "Distinct pickup zips",
                  "fieldName": "countdistinct(pickup_zip)",
                  "rowNumber": 0
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Distinct pickup zips"
              },
              "version": 2,
              "widgetType": "counter"
            }
          }
        },
        {
          "position": {
            "height": 6,
            "width": 4,
            "x": 2,
            "y": 1
          },
          "widget": {
            "name": "bar-top-pickup-zips",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_zip",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "`pickup_zip`",
                      "name": "pickup_zip"
                    },
                    {
                      "expression": "SUM(`trips`)",
                      "name": "sum(trips)"
                    }
                  ],
                  "limit": 15,
                  "orders": [
                    {
                      "direction": "DESC",
                      "expression": "SUM(`trips`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "data": {
                "queryName": "main_query"
              },
              "encodings": {
                "x": {
