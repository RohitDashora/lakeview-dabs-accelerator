                  "fieldName": "pickup_zip",
                  "scale": {
                    "sort": {
                      "by": "y-reversed"
                    },
                    "type": "categorical"
                  }
                },
                "y": {
                  "displayName": "Trips",
                  "fieldName": "sum(trips)",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Top 15 pickup zips by trips"
              },
              "version": 3,
              "widgetType": "bar"
            }
