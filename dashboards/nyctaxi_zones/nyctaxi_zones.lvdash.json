            "spec": {
              "data": {
                "queryName": "main_query"
              },
              "encodings": {
                "columns": [
                  {
                    "displayName": "Pickup zip",
                    "fieldName": "pickup_zip"
                  },
                  {
                    "displayName": "Dropoff zip",
                    "fieldName": "dropoff_zip"
                  },
                  {
                    "displayName": "Trips",
                    "fieldName": "trips"
                  },
                  {
                    "displayName": "Avg fare",
                    "fieldName": "avg_fare"
                  },
