            "height": 8,
            "width": 6,
            "x": 0,
            "y": 7
          },
          "widget": {
            "name": "table-top-routes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_zip",
                  "disaggregated": true,
                  "fields": [
                    {
                      "expression": "`pickup_zip`",
                      "name": "pickup_zip"
                    },
                    {
                      "expression": "`dropoff_zip`",
                      "name": "dropoff_zip"
                    },
                    {
                      "expression": "`trips`",
                      "name": "trips"
                    },
                    {
                      "expression": "`avg_fare`",
                      "name": "avg_fare"
                    },
                    {
                      "expression": "`avg_distance`",
